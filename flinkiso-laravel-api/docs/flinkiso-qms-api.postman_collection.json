							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('status is 200', function () { pm.response.to.have.status(200); });",
									"var j = pm.response.json();",
									"if (j.user && j.user.sub) { pm.collectionVariables.set('me_user_id', j.user.sub); }"
								]
							}
						}
					]
				},
