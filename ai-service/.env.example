# AI microservice config
AI_SERVICE_TOKEN=change-me-strong-token       # FlinkISO sends this as Bearer; blank = open (dev only)

# ---- LLM provider (CAPA suggestions) --------------------------------------
# Selects the AI provider. Swappable without code changes. One of:
#   openai | azure | anthropic | gemini | ollama | none
# Unset  -> "openai" when OPENAI_API_KEY is present, else "none" (rule-based).
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=                               # blank = rule-based CAPA fallback
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   # override for OpenAI-compatible gateways

# Azure OpenAI
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=<deployment-name>
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Google Gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# Ollama (local / self-hosted, no key)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1
